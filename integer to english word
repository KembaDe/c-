#include <stdlib.h>
#include <string.h>

char* units[] = {"", "One", "Two", "Three", "Four", "Five", "Six", "Seven", "Eight", "Nine", "Ten", 
                 "Eleven", "Twelve", "Thirteen", "Fourteen", "Fifteen", "Sixteen", "Seventeen", "Eighteen", "Nineteen"};
char* tens[] = {"", "", "Twenty", "Thirty", "Forty", "Fifty", "Sixty", "Seventy", "Eighty", "Ninety"};
char* thousands[] = {"", "Thousand", "Million", "Billion"};

void helper(int num, char* res) {
    if (num == 0) return;
    
    if (strlen(res) > 0 && res[strlen(res) - 1] != ' ') strcat(res, " ");

    if (num < 20) {
        strcat(res, units[num]);
    } else if (num < 100) {
        strcat(res, tens[num / 10]);
        helper(num % 10, res);
    } else {
        strcat(res, units[num / 100]);
        strcat(res, " Hundred");
        helper(num % 100, res);
    }
}

char* numberToWords(int num) {
    if (num == 0) return "Zero";

    char* res = (char*)malloc(1024 * sizeof(char));
    res[0] = '\0';

    int group[4]; // Billion, Million, Thousand, Ones
    int n = num;
    for (int i = 0; i < 4; i++) {
        group[3 - i] = n % 1000;
        n /= 1000;
    }

    for (int i = 0; i < 4; i++) {
        if (group[i] != 0) {
            helper(group[i], res);
            if (i < 3) { // Add Thousand/Million/Billion scale
                if (strlen(res) > 0 && res[strlen(res) - 1] != ' ') strcat(res, " ");
                strcat(res, thousands[3 - i]);
            }
        }
    }

    // Final check for any accidental trailing space
    int len = strlen(res);
    if (len > 0 && res[len - 1] == ' ') res[len - 1] = '\0';

    return res;
}
