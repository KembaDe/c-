int minPatches(int* nums, int numsSize, int n) {
    long miss = 1;
    int patches = 0;
    int i = 0;

    while (miss <= n) {
        if (i < numsSize && nums[i] <= miss) {
            // Use existing number to extend the range
            miss += nums[i];
            i++;
        } else {
            // Patch the array with 'miss' to double the range
            miss += miss;
            patches++;
        }
    }

    return patches;
}
