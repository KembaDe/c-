#include <stdlib.h>

// Comparison function for qsort
int compare(const void* a, const void* b) {
    int* e1 = *(int**)a;
    int* e2 = *(int**)b;
    if (e1[0] == e2[0]) {
        // Same width: heights descending
        return e2[1] - e1[1];
    }
    // Different width: widths ascending
    return e1[0] - e2[0];
}

int maxEnvelopes(int** envelopes, int envelopesSize, int* envelopesColSize) {
    if (envelopesSize == 0) return 0;

    // 1. Sort envelopes
    qsort(envelopes, envelopesSize, sizeof(int*), compare);

    // 2. Find LIS of heights using Patience Sorting (Binary Search)
    int* tails = (int*)malloc(envelopesSize * sizeof(int));
    int size = 0;

    for (int i = 0; i < envelopesSize; i++) {
        int h = envelopes[i][1];
        
        // Binary search for the insertion point (lower bound)
        int left = 0, right = size;
        while (left < right) {
            int mid = left + (right - left) / 2;
            if (tails[mid] < h) left = mid + 1;
            else right = mid;
        }
        
        tails[left] = h;
        if (left == size) size++;
    }

    free(tails);
    return size;
}
