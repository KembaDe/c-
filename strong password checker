#include <stdio.h>
#include <string.h>
#include <math.h>

#define MAX(a, b) ((a) > (b) ? (a) : (b))
#define MIN(a, b) ((a) < (b) ? (a) : (b))

int strongPasswordChecker(char* password) {
    int n = strlen(password);
    int hasLower = 0, hasUpper = 0, hasDigit = 0;
    for (int i = 0; i < n; i++) {
        if (password[i] >= 'a' && password[i] <= 'z') hasLower = 1;
        else if (password[i] >= 'A' && password[i] <= 'Z') hasUpper = 1;
        else if (password[i] >= '0' && password[i] <= '9') hasDigit = 1;
    }
    int missingTypes = (1 - hasLower) + (1 - hasUpper) + (1 - hasDigit);

    // Track repeating sequences
    int replace = 0, oneDel = 0, twoDel = 0;
    for (int i = 2; i < n; i++) {
        if (password[i] == password[i-1] && password[i-1] == password[i-2]) {
            int len = 2;
            while (i < n && password[i] == password[i-1]) {
                len++;
                i++;
            }
            replace += len / 3;
            if (len % 3 == 0) oneDel++;
            else if (len % 3 == 1) twoDel++;
        }
    }

    if (n < 6) {
        return MAX(missingTypes, 6 - n);
    } else if (n <= 20) {
        return MAX(missingTypes, replace);
    } else {
        int deleteNeeded = n - 20;
        // Step 1: Use deletions to reduce replacements (len % 3 == 0)
        int d = MIN(deleteNeeded, oneDel);
        replace -= d;
        deleteNeeded -= d;

        // Step 2: Use deletions to reduce replacements (len % 3 == 1)
        d = MIN(deleteNeeded, twoDel * 2);
        replace -= d / 2;
        deleteNeeded -= d;

        // Step 3: Any remaining deletions
        d = MIN(deleteNeeded, replace * 3);
        replace -= d / 3;
        deleteNeeded -= d;

        return (n - 20) + MAX(missingTypes, replace);
    }
}
